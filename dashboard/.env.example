# Copy to .env.local and fill in. The Mac's dev/preview server keeps them to itself; `npm run frame`
# builds them into the kiosk app (APK and dist-frame/, both gitignored), so they do reach the frame.
# Free key from https://developer.wmata.com
WMATA_API_KEY=

# Google calendars: Settings → your calendar → "Secret address in iCal format". One line each,
# CAL_<ID>, where <id> matches `calendars` in src/content.js. Reset the address if it ever leaks.
CAL_PERSONAL=
